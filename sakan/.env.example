# ── قاعدة بيانات المستخدمين والسكنات والمفضلة والحجوزات (اسم الـ DB: Next-Auth) ──
MONGO_AUTH_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority

# ── قاعدة بيانات المحتوى (المدونة + طلبات الدعم) — بتستخدمها /api/data ──
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/content?retryWrites=true&w=majority

# ── NextAuth ──
# ولّد قيمة قوية:  openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# لو مستضيف خارج Vercel (VPS / Docker...) فعّل السطر ده:
# AUTH_TRUST_HOST=true
# ولو بتنشر على دومين، حدده:
# AUTH_URL=https://your-domain.com

# ── رقم واتساب سكن (بصيغة دولية بدون +) — بيظهر في صفحة تفاصيل السكن ──
NEXT_PUBLIC_WHATSAPP_NUMBER=201000000000

# ── رفع الصور (Cloudinary — خطة مجانية بدون كارت: cloudinary.com) ──
# من Dashboard ← Settings ← API Keys. السر (SECRET) ماتحطوش في أي ملف public.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=change-me

# ── Rate limiting مشترك (Upstash Redis — خطة مجانية: upstash.com) ──
# ضروري لو هتنشر على Vercel. من Database ← REST API.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=change-me
